enum JobType {
  remote
  on_site
  hybrid
}

enum JobStatus {
  ACTIVE
  CLOSED
  PAUSED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  email            String        @unique
  role             String?
  phone            String?
  about            String?
  availability     String?
  photoUrl         String?
  resumeUrl        String?
  skills           String[]
  location         String?
  documents        Json?
  createdAt        DateTime      @default(now())
  applications     Application[]
  savedJobs        SavedJob[]
  profileCompleted Boolean?
}

model Job {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  company      String
  category     String
  jobType      JobType
  location     String
  salary       String
  description  String
  requirements String[]
  hoursPerWeek String?
  contactEmail String
  postedDate   DateTime      @default(now())
  isVerified   Boolean       @default(true)
  status       JobStatus     @default(ACTIVE)
  views        Int           @default(0)
  applicants   Int           @default(0)
  Application  Application[]
  SavedJob     SavedJob[]
}

model Application {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String   @db.Uuid
  status    String   @default("applied")
  createdAt DateTime @default(now())
}

model SavedJob {
  id     String @id @default(uuid()) @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid
  job    Job    @relation(fields: [jobId], references: [id])
  jobId  String @db.Uuid
}
